{
  "rules": {
    ".read": false,
    ".write": false,
    "pos_sync": {
      "$code": {
        ".validate": "$code.matches(/^[0-9a-f]{32}$/)",
        ".read": true,
        ".write": true,
        "meta": {
          ".validate": "newData.hasChildren(['createdAt'])"
        },
        "events": {
          ".indexOn": ["t"],
          "$eventId": {
            ".validate": "newData.hasChildren(['n','t','d']) && newData.child('d').isString() && newData.child('d').val().length < 12000000"
          }
        },
        "live": {
          ".indexOn": ["t"],
          "$eventId": {
            ".validate": "newData.hasChildren(['n','t','d']) && newData.child('d').isString() && newData.child('d').val().length < 12000000"
          }
        },
        "presence": {
          "$deviceId": {
            ".validate": "newData.hasChildren(['t'])"
          }
        },
        "registers": {
          "$deviceId": {
            ".validate": "newData.hasChildren(['no','t']) && newData.child('no').isNumber()"
          }
        },
        "business_state": {
          ".validate": "newData.hasChildren(['d','t']) && newData.child('d').isString() && newData.child('d').val().length < 100000"
        }
      }
    },
    "pos_backup": {
      "$code": {
        ".validate": "$code.matches(/^[0-9a-f]{32}$/) && newData.hasChildren(['d','h','at'])",
        ".read": true,
        ".write": true,
        "d": {
          ".validate": "newData.isString() && newData.val().length < 12000000"
        },
        "h": {
          ".validate": "newData.isString() && newData.val().length < 100"
        }
      }
    }
  }
}
