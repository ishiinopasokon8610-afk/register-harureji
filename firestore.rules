rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // 店舗ごとの「合言葉」設定（SHA-256ハッシュのみを保持）
    // ------------------------------------------------------------
    // 合言葉そのものは一切保存しない。クライアント側(shop-id-system.js)で
    // SHA-256ハッシュ化してから送信し、ここではハッシュだけを比較する。
    // ==========================================================
    match /shops/{shopId}/config/auth {
      allow read: if request.auth != null;

      // 新規作成：この店舗IDでまだ合言葉が登録されていない場合のみ、
      // 認証済みユーザーなら誰でも「最初の1回」だけ登録できる
      // （＝店舗IDを知っていて、これから使い始める人）。
      allow create: if request.auth != null
                    && !exists(/databases/$(database)/documents/shops/$(shopId)/config/auth)
                    && request.resource.data.passphraseHash is string
                    && request.resource.data.passphraseHash.size() == 64;

      // 更新（合言葉の変更）：現在の合言葉ハッシュを知っている
      // （＝oldPassphraseHashとして正しい値を送れる）人だけが変更できる。
      allow update: if request.auth != null
                    && request.resource.data.passphraseHash is string
                    && request.resource.data.passphraseHash.size() == 64
                    && request.resource.data.oldPassphraseHash == resource.data.passphraseHash;

      allow delete: if false;
    }

    // ==========================================================
    // クラウドバックアップ本体（商品・顧客・売上履歴など）
    // ------------------------------------------------------------
    // 書き込み時は必ず、対応する店舗の合言葉ハッシュ(pwHash)を
    // 一緒に送らせ、config/auth に保存されているハッシュと一致した
    // 場合のみ許可する。合言葉を知らない第三者は、shopIdが漏れても
    // 書き込み（改ざん・破壊）はできない。
    // ==========================================================
    match /shops/{shopId}/backups/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && exists(/databases/$(database)/documents/shops/$(shopId)/config/auth)
                   && request.resource.data.pwHash is string
                   && request.resource.data.pwHash ==
                      get(/databases/$(database)/documents/shops/$(shopId)/config/auth).data.passphraseHash;
    }

    // 上記以外は明示的にブロック（デフォルト拒否）
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
